{
  "name": "shenchengji-open-roads",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && vite --host 127.0.0.1",
